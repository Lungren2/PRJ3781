# Copy to .env to override the defaults in docker-compose.yml. Every value is
# optional; server/README.md documents the full set the crawler understands.

# Crawler identity. Set this to a real contact URL before pointing the crawler at
# anything outside a local experiment.
# MORROW_USER_AGENT=MorrowBot/0.1 (+https://example.com/about-crawler; you@example.com)

# Run the daily scheduled crawl inside the container. Off by default so a
# container started to look at the UI does not begin crawling on its own.
# MORROW_CRAWL_SCHEDULE_ENABLED=1

# Per-provider toggles.
# MICROSOFT_LEARN_ENABLED=1
# COURSERA_ENABLED=1

# Strict robots posture for Coursera; see server/README.md for the tension here.
# COURSERA_USE_CATALOG_API=0

# Comma-separated browser origins allowed to call the API directly.
# MORROW_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Login sessions and sign-up/login rate limiting.
# MORROW_SESSION_TTL_HOURS=8
# MORROW_LOGIN_WINDOW_MINUTES=15
# MORROW_LOGIN_MAX_ATTEMPTS=8
# MORROW_LOGIN_MAX_IP_ATTEMPTS=40
# Company IDs allowed to browse candidates, separated by commas. Empty blocks all.
# MORROW_APPROVED_EMPLOYER_IDS=

# Local development prints email links in the API terminal. No SMTP needed.
# MORROW_MAIL_TRANSPORT=console
# Use MORROW_MAIL_TRANSPORT=smtp to test real email locally.
# Production uses SMTP; set these in server/.env locally or root .env for Docker.
# MONGODB_URI=your-mongodb-connection-string
# MORROW_APP_URL=http://127.0.0.1:5173
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM=your-verified-sender@example.com
