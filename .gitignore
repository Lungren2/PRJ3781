node_modules
dist
.vite
*.local

# Local environment and secrets. The crawler takes its provider toggles, contact
# user-agent, and storage paths from the environment.
.env
.env.*
!.env.example
jobCrawler.env

# SQLite record store, wherever MORROW_DB_PATH points (-wal/-shm are WAL sidecars).
*.db
*.db-wal
*.db-shm

# Crawler HTTP response cache, wherever MORROW_CACHE_DIR points.
.cache/

# Logs
*.log
npm-debug.log*

# OS and editor noise
.DS_Store
*.swp

# Not ignored on purpose: public/data/certifications.json. It is generated by
# `npm run crawl:export`, but stays tracked so the site still works when the
# crawler API is unavailable.
